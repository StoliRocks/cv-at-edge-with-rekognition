# Jetson Edge CV Application - Environment Variables
# Copy this file to .env and configure for your deployment

# =============================================================================
# Application Settings
# =============================================================================
EDGE_APP_NAME=jetson-edge-cv
EDGE_DEBUG=false

# =============================================================================
# Video Source Settings
# =============================================================================
# Source can be: file path, camera index (0, 1), RTSP URL, or 'csi'
EDGE_VIDEO__SOURCE=0
EDGE_VIDEO__SOURCE_TYPE=auto
EDGE_VIDEO__WIDTH=1280
EDGE_VIDEO__HEIGHT=720
EDGE_VIDEO__FPS=30
EDGE_VIDEO__FLIP_METHOD=0

# =============================================================================
# Inference Settings
# =============================================================================
EDGE_INFERENCE__MODEL_PATH=models/yolov8n.onnx
EDGE_INFERENCE__BACKEND=auto
EDGE_INFERENCE__DEVICE=cuda:0
EDGE_INFERENCE__CONFIDENCE_THRESHOLD=0.5
EDGE_INFERENCE__NMS_THRESHOLD=0.45

# =============================================================================
# Detection Settings
# =============================================================================
EDGE_DETECTION__TARGET_CLASSES=["truck","car"]
EDGE_DETECTION__IOU_THRESHOLD=0.3
EDGE_DETECTION__STATE_PERSISTENCE_FRAMES=3

# Region of Interest (normalized 0-1)
EDGE_DETECTION__ROI_X1=0.10
EDGE_DETECTION__ROI_Y1=0.10
EDGE_DETECTION__ROI_X2=0.85
EDGE_DETECTION__ROI_Y2=0.90
EDGE_DETECTION__ROI_NAME=garage_bay_01

# =============================================================================
# AWS Settings
# =============================================================================
EDGE_AWS__REGION=us-east-1
EDGE_AWS__IOT_ENDPOINT=
EDGE_AWS__IOT_THING_NAME=JetsonEdgeDevice
EDGE_AWS__IOT_TOPIC=garage/001/bay/01
EDGE_AWS__S3_BUCKET=
EDGE_AWS__S3_PREFIX=frames/
EDGE_AWS__CERT_PATH=certs/device.cert.pem
EDGE_AWS__KEY_PATH=certs/device.private.key
EDGE_AWS__ROOT_CA_PATH=certs/AmazonRootCA1.pem
EDGE_AWS__UPLOAD_IMAGES=false
EDGE_AWS__UPLOAD_INTERVAL=5

# =============================================================================
# Output Settings
# =============================================================================
EDGE_OUTPUT__ENABLE_DISPLAY=false
EDGE_OUTPUT__ENABLE_RTSP=false
EDGE_OUTPUT__RTSP_PORT=8554
EDGE_OUTPUT__DRAW_DETECTIONS=true
EDGE_OUTPUT__DRAW_ROI=true

# =============================================================================
# Logging Settings
# =============================================================================
EDGE_LOGGING__LEVEL=INFO
EDGE_LOGGING__ENABLE_METRICS=true
